<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Canonical domain: force https://sewgo.io (no www, HTTPS only).
    # Scoped to the sewgo.io host only, so local development (localhost /
    # 127.0.0.1) is never redirected.
    RewriteCond %{HTTP_HOST} ^www\.sewgo\.io$ [NC]
    RewriteRule ^ https://sewgo.io%{REQUEST_URI} [L,R=301]

    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} ^sewgo\.io$ [NC]
    RewriteRule ^ https://sewgo.io%{REQUEST_URI} [L,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Serve a pre-generated WebP version of an image automatically when the
    # browser supports it and a "<name>.<ext>.webp" sibling exists on disk.
    # No <img> markup needs to change — this is pure content negotiation.
    RewriteCond %{HTTP_ACCEPT} image/webp
    RewriteCond %{REQUEST_FILENAME}\.webp -f
    RewriteRule ^(.+)\.(jpe?g|png)$ $1.$2.webp [L,T=image/webp,E=accept:1]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    # Tell caches/CDNs the response varies by Accept, since the same image
    # URL can now serve either the original or its WebP version.
    Header append Vary Accept env=REDIRECT_accept
</IfModule>
